# Pocket Money production configuration — copy to .env and fill in.
# Loaded by the systemd unit (EnvironmentFile) and by deploy.sh for alembic.

DATABASE_URL=postgresql+psycopg2://pocketMoney@/pmoney?host=/var/run/postgresql
AUTH_ENABLED=true

# Google OAuth (see DEPLOYMENT.md for setup instructions)
GOOGLE_CLIENT_ID=

# Long random strings — e.g. `openssl rand -hex 32`
JWT_SECRET=
DEPLOY_SECRET=

# Comma-separated bootstrap allowlist. The FIRST of these to sign in
# becomes the admin; invite everyone else from the app afterwards.
ALLOWED_EMAILS=

CURRENCY_SYMBOL=$

# Gmail SMTP relay for the daily admin digest (see DEPLOYMENT.md for
# App Password setup instructions). SMTP_USER unset = digest logs to
# stdout instead of sending. Defaults already target Gmail — usually
# only SMTP_USER/SMTP_PASSWORD need setting.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google Sheets ledger mirror — one append-only tab per child plus a
# Totals tab (see DEPLOYMENT.md for service-account setup). GOOGLE_SHEET_ID
# is the long id in the sheet's URL; unset = mirror disabled.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/pocketMoney/google-service-account.json
# Dates in the sheet are shown in this IANA timezone.
SHEET_TIMEZONE=Australia/Canberra
