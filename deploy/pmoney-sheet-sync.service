# /etc/systemd/system/pmoney-sheet-sync.service — Google Sheets ledger catch-up (no-op without GOOGLE_SHEET_ID) (fleet spec DEP-5: a timer, not
# cron, so the last run has a queryable Result that scripts/smoke_check.sh reads).
[Unit]
Description=Pocket Money Google Sheets ledger catch-up (no-op without GOOGLE_SHEET_ID)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=pocketMoney
WorkingDirectory=/opt/pocketMoney
EnvironmentFile=/opt/pocketMoney/.env
ExecStart=/opt/pocketMoney/.venv/bin/python scripts/sync_sheet.py
