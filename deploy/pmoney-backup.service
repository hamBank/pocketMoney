# /etc/systemd/system/pmoney-backup.service — nightly ledger backup (fleet spec
# DEP-5/DEP-6). 7-day rotation by weekday number. pipefail so a failed pg_dump
# fails the unit instead of writing an empty .gz and exiting 0 (which the old
# cron line did), and written to a temporary file first so a failure never
# replaces the last good backup, and the off-box pull (deploy/backup-server/)
# never sees a half-written one. `%%` and `$$` are systemd's escapes for % and $.
[Unit]
Description=Pocket Money nightly pg_dump
After=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/bin/bash -o pipefail -c 'out=/var/backups/pmoney/pmoney-$$(date +%%u).sql.gz; pg_dump pmoney | gzip > "$$out.tmp" && mv "$$out.tmp" "$$out"'
